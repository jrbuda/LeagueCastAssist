# LeagueCastAssist media server configuration
# Installed at /etc/lca.env, read by lca-media.service.
#
# Secrets live in tokens.json (sha256 hashes only); nothing here is a credential.

LCA_MEDIA_ROOT=/home/bots/LeagueCastAssistServer/lca-media
LCA_MANIFEST=/home/bots/LeagueCastAssistServer/manifest.json
LCA_TOKENS_FILE=/home/bots/LeagueCastAssistServer/tokens.json
LCA_LOG_DIR=/home/bots/LeagueCastAssistServer/logs
LCA_LOG_RETENTION_DAYS=14

# Loopback only: Apache is the public face.
LCA_HOST=127.0.0.1
LCA_PORT=38030

# Abuse limits per client IP.
LCA_RATE_REQUESTS=120
LCA_RATE_BURST=60
LCA_MAX_CONCURRENT=3
